# Which LLM provider the agent uses.
# mock      -> deterministic stub, no network, no API key. This is the default so the
#              demo runs anywhere (including a client machine with no internet).
# openai    -> real calls, needs OPENAI_API_KEY
# anthropic -> real calls, needs ANTHROPIC_API_KEY
LLM_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model names used when a real provider is enabled.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Below this confidence the case is routed to a human instead of being decided.
CONFIDENCE_THRESHOLD=0.70

# Hard cap on tool calls inside the evidence stage.
MAX_TOOL_CALLS=6
